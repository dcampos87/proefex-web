{
  "name": "proefex-web",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:mock": "node scripts/validate-mock-dataset.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
